{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Loop Soundbank Builder",
  "version": "0.1.0",
  "identifier": "dev.looper.soundbank",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Game Loop Soundbank Builder",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "app", "dmg"],
    "icon": [
      "icons/icon.png"
    ]
  }
}
